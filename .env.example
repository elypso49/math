# Source des données et de l'authentification :
#   local    → connexion Google simulée, données dans le localStorage du navigateur
#   mltstore → vraie connexion Google (GIS) et module Math de MltStore
VITE_DATA_MODE=local

# Origine MltStore en mode mltstore. Vide en production : /api est servi
# same-origin et nginx relaie vers le conteneur mltstore-api.
VITE_MLTSTORE_URL=http://localhost:8080

# Client ID OAuth Web Google partagé par les apps MltStore (valeur publique).
VITE_GOOGLE_CLIENT_ID=
